# Copy this to backend/.env and frontend/.env.local
# Then fill in your actual values

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── CALL-E ───────────────────────────────────────────────
CALLE_API_KEY=your-calle-api-key
CALLE_BASE_URL=https://api.heycall-e.com
# CALL-E does not sign webhooks; this random string forms the callback path.
# python -c "import secrets;print(secrets.token_urlsafe(32))"
CALLE_WEBHOOK_TOKEN=generate-a-long-random-string

# ── Resend ───────────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=refcheck@yourdomain.com

# ── Polar.sh ─────────────────────────────────────────────
NEXT_PUBLIC_POLAR_ORG=your-polar-org-slug
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# ── App URLs ─────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin (bypasses all Polar checks) ────────────────────
ADMIN_EMAIL=hector@yourdomain.com
NEXT_PUBLIC_ADMIN_EMAIL=hector@yourdomain.com
