# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CALL-E  (keys: https://dashboard.heycall-e.com/account/api-keys)
CALLE_API_KEY=iams_live_your_key
CALLE_BASE_URL=https://api.heycall-e.com
# Random secret that forms the webhook path. CALL-E does not sign webhooks,
# so this must be unguessable:  python -c "import secrets;print(secrets.token_urlsafe(32))"
CALLE_WEBHOOK_TOKEN=generate-a-long-random-string

# Resend (email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=refcheck@yourdomain.com

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ADMIN_EMAIL=hector@yourdomain.com

# Polar.sh
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Optional dial allowlist (comma-separated E.164). Leave empty in production,
# where recruiters supply referee numbers. SET IT in dev and staging so a
# misconfigured environment cannot place calls to real people.
CALLE_DIAL_ALLOWLIST=
